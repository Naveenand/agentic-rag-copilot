# Copy to .env and fill in. Never commit .env.
# Every setting in app/core/config.py can be set here by its name in upper case.

# --- Required ---
OPENAI_API_KEY=
PINECONE_API_KEY=
TAVILY_API_KEY=
# Protects document upload and the audit log. Use 16+ random characters, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_API_KEY=change-me

# --- Environment ---
APP_ENV=development
LOG_LEVEL=INFO

# --- Docker on a server (docker compose reads these too) ---
# BIND_ADDR=0.0.0.0
# HOST_PORT=80

# --- Optional overrides (defaults shown) ---
# FAST_MODEL=gpt-6-luna
# STRONG_MODEL=gpt-6.1-sol
# STRONG_REASONING_EFFORT=medium
# PINECONE_INDEX_NAME=industry-agentic-rag-kb
# PINECONE_NAMESPACE=langgraph-docs-v2-bge-small
# ENABLE_WEB=true
# RATE_LIMIT_PER_MINUTE=30
# Set ACCESS_CODE to require a code before asking (for public demos):
# ACCESS_CODE=
# DAILY_QUESTION_LIMIT=0
# MAX_UPLOAD_MB=10
# CHECKPOINTER=sqlite
# SOURCE_URLS=["https://docs.langchain.com/oss/python/langgraph/agentic-rag"]
# AUTO_INGEST=false
# FRAME_ANCESTORS='none'

# Optional: LangSmith tracing dashboard
# LANGSMITH_TRACING=true
# LANGSMITH_API_KEY=
# LANGSMITH_PROJECT=agentic-rag-copilot